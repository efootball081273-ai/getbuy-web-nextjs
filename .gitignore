# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/prisma/.phase8-test-*.db
/prisma/.phase8-test-*.db-journal
/prisma/.phase8-test-*.db-shm
/prisma/.phase8-test-*.db-wal
/dev.db
/dev.db-journal
/dev.db-shm
/dev.db-wal

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
